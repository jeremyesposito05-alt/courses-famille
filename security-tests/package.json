{
  "name": "famille-security-tests",
  "private": true,
  "version": "0.1.0",
  "description": "Tests exclusivement sur émulateur des règles Firestore bêta",
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-famille-rules-tests --only firestore --config ./firebase.json \"node --test ./tests/firestore.rules.test.mjs\"",
    "test:in-emulator": "node --test ./tests/firestore.rules.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
